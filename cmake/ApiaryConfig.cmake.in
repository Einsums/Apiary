# ApiaryConfig.cmake — package config for find_package(Apiary).
#
# Provides:
#   apiary::annotations  - INTERFACE target carrying the APIARY_* macro header
#                          (always present)
#   apiary::apiary       - the codegen executable (IMPORTED). Present only when
#                          the tool was built and its ApiaryTool component
#                          installed; an annotations-only install omits it.
#                          Ask for it with ``find_package(Apiary COMPONENTS tool)``,
#                          or test APIARY_TOOL_FOUND.
#   APIARY_LLVM_VERSION_MAJOR - the LLVM major the executable was built against
#   apiary_detect_toolchain() and the other apiary_* helper functions, with
#   APIARY_SCRIPTS_DIR   - directory of the bundled Python scripts
#                          (apiary_aggregate_stubs.py, apiary_render_cpp_rst.py, apiary_render_docs_rst.py).
#                          Both ship in the ApiaryTool component.
#
# Components: ``annotations`` is always found; ``tool`` is found when the
# executable is installed.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ApiaryTargets.cmake")
set(Apiary_annotations_FOUND TRUE)

# The ApiaryTool component, which an annotations-only install leaves out.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ApiaryTool.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ApiaryTool.cmake")
    set(APIARY_TOOL_FOUND TRUE)
else()
    set(APIARY_TOOL_FOUND FALSE)
endif()
set(Apiary_tool_FOUND ${APIARY_TOOL_FOUND})

# The helpers and their scripts come with the ApiaryTool component, but not
# only with the executable: a build without the tool still installs them.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ApiaryHelpers.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ApiaryHelpers.cmake")
    set_and_check(APIARY_SCRIPTS_DIR "@PACKAGE_APIARY_SCRIPTS_DIR@")
endif()

check_required_components(Apiary)
# check_required_components() gives no reason, and CMake then reports only
# that Apiary_FOUND was set to FALSE.
if(NOT Apiary_FOUND AND Apiary_FIND_REQUIRED_tool AND NOT APIARY_TOOL_FOUND)
    string(CONCAT Apiary_NOT_FOUND_MESSAGE
        "the install at ${PACKAGE_PREFIX_DIR} has the annotations but not the codegen executable "
        "(the ApiaryTool component; on conda-forge, the apiary package).")
endif()
